  "info": {
    "title": "Job Portal API",
    "description": "A comprehensive API for managing jobs, applications, users, and messaging. Supports multiple user roles: JobSeeker, Employer, and Admin.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": ""
    },
    {
      "name": "Users",
      "description": ""
    },
    {
      "name": "Jobs",
      "description": ""
    },
    {
      "name": "Applications",
      "description": ""
    },
    {
      "name": "Messages",
      "description": ""
    },
    {
      "name": "Admin",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Enter JWT token",
        "name": "Authorization",
        "in": "header"
      }
    },
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 6
          },
          "role": {
            "type": "string",
            "enum": [
              "JobSeeker",
              "Employer",
              "Admin"
            ],
            "example": "JobSeeker"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "address": {
            "type": "string",
            "example": "123 Main St, New York, NY"
          }
        },
        "required": [
          "email",
          "password",
          "role",
          "name",
          "address"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "JobSeeker",
              "Employer",
              "Admin"
            ]
          },
          "resumeUrl": {
            "type": "string",
            "example": "https://cloudinary.com/resume.pdf"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "address": {
            "type": "string",
            "example": "123 Main St, New York, NY"
          },
          "telephone": {
            "type": "string",
            "example": "+1-555-0199"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "email",
          "role",
          "name",
          "address",
          "telephone",
          "isActive"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "newemail@example.com"
          },
          "password": {
            "type": "string",
            "example": "newpassword123",
            "minLength": 6
          },
          "role": {
            "type": "string",
            "enum": [
              "JobSeeker",
              "Employer",
              "Admin"
            ]
          }
        }
      },
      "CreateJobDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Senior Software Engineer"
          },
          "description": {
            "type": "string",
            "example": "We are looking for a Node.js expert..."
          },
          "salary": {
            "type": "number",
            "example": 120000
          },
          "location": {
            "type": "string",
            "example": "Remote"
          }
        },
        "required": [
          "title",
          "description"
        ]
      },
      "Job": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Software Engineer"
          },
          "description": {
            "type": "string",
            "example": "Job description here..."
          },
          "salary": {
            "type": "number",
            "example": 120000
          },
          "location": {
            "type": "string",
            "example": "Remote / New York"
          },
          "employerId": {
            "type": "string",
            "example": "65c123abc..."
          }
        },
        "required": [
          "title",
          "description",
          "salary",
          "location",
          "employerId"
        ]
      },
      "UpdateJobDto": {
        "type": "object",
        "properties": {}
      },
      "CreateApplicationDto": {
        "type": "object",
        "properties": {}
      },
      "Application": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Applied",
              "Viewed",
              "Rejected"
            ],
            "example": "Applied"
          },
          "resumeUrl": {
            "type": "string",
            "example": "https://cloudinary.com/resume.pdf"
          },
          "coverLetter": {
            "type": "string",
            "example": "I am highly motivated..."
          },
          "jobId": {
            "type": "string",
            "example": "65c123abc..."
          },
          "jobSeekerId": {
            "type": "string",
            "example": "65d456def..."
          }
        },
        "required": [
          "status",
          "resumeUrl",
          "coverLetter",
          "jobId",
          "jobSeekerId"
        ]
      },
      "CreateMessageDto": {
        "type": "object",
        "properties": {}
      },
      "Message": {
        "type": "object",
        "properties": {
          "senderId": {
            "type": "string",
            "example": "65c111aaa..."
          },
          "receiverId": {
            "type": "string",
            "example": "65c222bbb..."
          },
          "content": {
            "type": "string",
            "example": "Hello, how are you?"
          }
        },
        "required": [
          "senderId",
          "receiverId",
          "content"
        ]
      }
    }
  }
}