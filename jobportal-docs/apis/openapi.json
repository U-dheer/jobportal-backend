              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT"
          },
          "404": {
            "description": "User not found"
          },
          "409": {
            "description": "Email already in use"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Update User Profile",
        "tags": [
          "Users"
        ]
      }
